@model SparkAdvancedViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel(SparkNavPages.Advanced, "Advanced").SetCategory(SparkNavCategory.Id));

    // A trail back to the plugin root, so the heading below is not the only entry in it. With no parent,
    // TitleHeader synthesises a single crumb equal to the title and prints it twice.
    BTCPayServer.ViewDataDictionaryExtensions.SetBreadcrumbs(ViewData,
        new BTCPayServer.Components.Breadcrumb.BreadcrumbItem("Flint", Action: "Status",
            Controller: "Spark", RouteValues: new { storeId = Model.StoreId }));
}

<div class="sticky-header">
    <vc:title-header />
</div>

<partial name="_StatusMessage" />

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">

        <h3 class="mb-3">Recovery phrase</h3>
        <table class="table">
            <tbody>
                <tr>
                    <th class="w-25">Source</th>
                    <td>
                        @switch (Model.SeedSource)
                        {
                            case SeedSource.Generated:
                                <span>Generated by this plugin and shown to you once during setup.</span>
                                break;
                            case SeedSource.Imported:
                                <span>Imported by you.</span>
                                break;
                            case SeedSource.HotWallet:
                                <span>Reused from this store's on-chain wallet.</span>
                                <div class="form-text text-warning">
                                    One phrase controls this store's Lightning funds and its on-chain funds.
                                </div>
                                break;
                        }
                        <div class="form-text">
                            Never shown again here. Your own backup is the recovery path.
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <a permission="@Policies.CanModifyStoreSettings" asp-action="Setup"
           asp-route-storeId="@Model.StoreId" class="btn btn-secondary" id="SparkReplaceSeed">
            Replace seed
        </a>

        <h3 class="mt-5 mb-3">Wallet details</h3>
        <table class="table table-sm">
            <tbody>
                <tr>
                    <th class="w-25">Spark identity</th>
                    <td>
                        @if (Model.IdentityPubkey is { } pubkey)
                        {
                            <vc:truncate-center text="@pubkey" classes="truncate-center-id" />
                        }
                        else
                        {
                            <span class="text-secondary">Not synced yet</span>
                        }
                    </td>
                </tr>
                @if (!string.IsNullOrEmpty(Model.StorageDirectory))
                {
                    <tr>
                        <th>SDK storage</th>
                        <td><code>@Model.StorageDirectory</code></td>
                    </tr>
                }
            </tbody>
        </table>

        <form method="post" asp-action="AdvancedSweep" asp-route-storeId="@Model.StoreId"
              permission="@Policies.CanModifyStoreSettings">
            <h3 class="mt-5 mb-3">Sweep tuning</h3>
            @if (!ViewContext.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="@(ViewContext.ModelState.ErrorCount.Equals(1) ? "no-marker" : "")"></div>
            }

            <div class="row">
                <div class="col-md-6 form-group">
                    <label asp-for="Settings.ReserveSats" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Settings.ReserveSats" type="number" min="0" step="1" class="form-control" />
                        <span class="input-group-text">sats</span>
                    </div>
                    <span asp-validation-for="Settings.ReserveSats" class="text-danger"></span>
                    <div class="form-text">
                        Left on Spark after each sweep. With the fee charged on top, this is also what pays it.
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="form-check">
                    <input asp-for="Settings.DrainWhenSweeping" type="checkbox" class="form-check-input" />
                    <label asp-for="Settings.DrainWhenSweeping" class="form-check-label"></label>
                    <div class="form-text">
                        On, the fee comes out of what is swept. Off, it is charged on top and paid from the
                        reserve — which then has to be bigger than the fee.
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" id="SparkSaveAdvancedSweep">Save</button>
        </form>

        <div permission="@Policies.CanModifyStoreSettings">
            <h3 class="mt-5 mb-3">Remove</h3>
            <div id="danger-zone" class="d-flex flex-wrap align-items-center gap-3 mb-5 mt-2">
                <a id="SparkRemove" class="btn btn-outline-danger" asp-action="Remove"
                   asp-route-storeId="@Model.StoreId">
                    Remove this store's Spark wallet
                </a>
            </div>
        </div>
    </div>
</div>

@section PageFootContent {
    <partial name="_ValidationScriptsPartial" />
}
