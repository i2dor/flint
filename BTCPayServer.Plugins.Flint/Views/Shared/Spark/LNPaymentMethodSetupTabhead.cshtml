@using BTCPayServer.Client
@using BTCPayServer.Plugins.Flint.Services
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BTCPayServer.Models.StoreViewModels.LightningNodeViewModel
@inject SparkService SparkService
@*
    Injected at "ln-payment-method-setup-tabhead": the pill in the store's "Connect to a Lightning node"
    screen, alongside "Use internal node" and "Use custom node".

    Two shapes, following the Boltz precedent. With no Spark wallet configured there is nothing for a pill to
    reveal, so this is a plain link into the plugin's own setup page — a merchant should never have to know
    that a connection string exists. With one configured it is a real pill that selects the Custom node type
    and fills core's connection-string field in, so pressing Save on core's own screen keeps working and
    writes exactly the configuration the plugin would write itself.

    On rendering the connection string, which embeds the store's payment key: this extension point is only
    ever rendered inside core's SetupLightningNode page, and both its GET and its POST require
    CanModifyStoreSettings. Core itself puts the store's existing connection string in the textarea on that
    same page. A view-only user never reaches here.

    The @using and @inject lines are repeated even though Views/_ViewImports.cshtml declares them: an
    extension-point partial is rendered from a core view's context, and relying on the plugin's imports
    reaching it there is an assumption worth not making.
*@
@if (Model.CryptoCode != "BTC")
{
    return;
}
@{
    // Awaited rather than blocked on: the service's startup gate is a Task and a Razor view is already async.
    var connectionString = await SparkService.GetConnectionString(Model.StoreId);
}
@if (connectionString is null)
{
    <a asp-controller="Spark" asp-action="Setup" asp-route-storeId="@Model.StoreId"
       permission="@Policies.CanModifyStoreSettings" role="tab" aria-selected="false">
        <label for="LightningNodeType-Spark">Set up Flint</label>
    </a>
}
else
{
    <input value="Custom" type="radio" id="LightningNodeType-Spark" data-bs-toggle="pill"
           data-bs-target="#SparkSetup" role="tab" aria-controls="SparkSetup" aria-selected="false"
           name="LightningNodeType">
    <label for="LightningNodeType-Spark">Use Flint</label>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sparkConnectionString = @Safe.Json(connectionString);
            const connStringEl = document.getElementById('ConnectionString');
            if (!connStringEl) return;
            delegate('change', 'input[name="LightningNodeType"]', () => {
                const active = document.querySelector('input[name="LightningNodeType"]:checked');
                if (active && active.id === 'LightningNodeType-Spark') {
                    connStringEl.value = sparkConnectionString;
                }
            });
        })
    </script>
}
